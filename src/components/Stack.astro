---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="stack">
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
  }

  .stack li {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
  }
</style>
