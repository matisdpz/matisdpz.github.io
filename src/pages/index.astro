---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Stack from "../components/Stack.astro";
import photo from "../assets/photo.jpg";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const links = [
  { label: "CV (PDF)", href: "/Matis_Di_Piazza_CV.pdf" },
  { label: "GitHub", href: "https://github.com/matisdpz" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/matis-di-piazza-19a375250" },
  { label: "Email", href: "mailto:dipiazzamatis@gmail.com" },
];

// Kept in sync with the CV (public/Matis_Di_Piazza_CV.pdf).
const skills = [
  { area: "Programming", items: "Python, Java, C/C++, SQL, TypeScript, OCaml, R, PHP, VBA" },
  {
    area: "Backend & data",
    items: "FastAPI, REST APIs, PostgreSQL, SQLAlchemy, relational databases, data analysis, statistics, Tableau, Power BI",
  },
  { area: "DevOps & tools", items: "Git, GitHub Actions (CI), Docker, Docker Compose, Linux, pytest" },
  { area: "Systems & networking", items: "TCP/IP, Unix sockets, computer networks, embedded C (STM32)" },
  {
    area: "AI/ML",
    items: "Reinforcement learning (MDPs, Q-learning, SARSA), state-space modeling, LLM API integration",
  },
];

const education = [
  {
    school: "Polytech Grenoble, Université Grenoble Alpes",
    degree: "Master's degree in Computer Science Engineering (Diplôme d'ingénieur)",
    years: "2025-2028",
  },
  {
    school: "Polytech Lyon, Université Claude Bernard Lyon 1",
    degree: "Classes préparatoires: intensive 2-year course in maths, physics and computer science",
    years: "2023-2025",
  },
];
---

<Base
  title="Matis Di Piazza"
  description="Computer Science Engineering student at Polytech Grenoble, looking for an internship from April to August 2027."
>
  <header class="intro">
    <Image
      src={photo}
      alt="Portrait of Matis Di Piazza"
      width={128}
      height={128}
      densities={[1, 2]}
      loading="eager"
      class="avatar"
    />
    <div>
      <h1>Matis Di Piazza</h1>
      <p class="muted">
        Computer Science Engineering student (4th year) at Polytech Grenoble, interested in
        software engineering, cloud infrastructure and machine learning. I like building
        systems that are tested, observable and easy to run.
      </p>
      <p class="availability">Looking for an internship: April to August 2027 (full-time)</p>
      <nav class="links">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </header>

  <section>
    <h2>Projects</h2>
    {
      projects.map((project) => (
        <article class="project">
          <a href={`/projects/${project.id}/`}>
            <Image src={project.data.cover} alt={project.data.coverAlt} width={720} loading="eager" />
          </a>
          <h3>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </h3>
          <p>{project.data.summary}</p>
          <Stack items={project.data.stack} />
        </article>
      ))
    }
  </section>

  <section>
    <h2>Skills</h2>
    <dl class="skills">
      {
        skills.map((skill) => (
          <>
            <dt>{skill.area}</dt>
            <dd>{skill.items}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>Education</h2>
    {
      education.map((item) => (
        <div class="education">
          <div class="education-head">
            <strong>{item.school}</strong>
            <span class="muted">{item.years}</span>
          </div>
          <div>{item.degree}</div>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .intro {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .avatar {
    flex-shrink: 0;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
    border: none;
  }

  @media (max-width: 30rem) {
    .intro {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .project + .project {
    margin-top: 2.5rem;
  }

  .project h3 {
    margin: 1rem 0 0.25rem;
  }

  .project p {
    margin: 0;
  }

  .availability {
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .education + .education {
    margin-top: 1rem;
  }

  .education-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .skills {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .skills {
      grid-template-columns: 1fr;
    }

    .skills dd {
      margin-bottom: 0.6rem;
    }
  }
</style>
