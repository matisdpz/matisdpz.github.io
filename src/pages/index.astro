---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Stack from "../components/Stack.astro";
import photo from "../assets/photo.jpg";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const links = [
  { label: "GitHub", href: "https://github.com/matisdpz" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/matis-di-piazza-19a375250" },
  { label: "Email", href: "mailto:dipiazzamatis@gmail.com" },
];

const skills = [
  { area: "Languages", items: "Python, Java, C/C++, SQL, TypeScript" },
  { area: "Backend", items: "FastAPI, Pydantic, SQLAlchemy, REST API design, PostgreSQL" },
  { area: "Infrastructure", items: "Docker, Docker Compose, nginx, GitHub Actions, Linux" },
  { area: "Practices", items: "Automated testing, database migrations, structured logging, code review" },
  { area: "Learning", items: "Cloud infrastructure, AI/ML" },
];
---

<Base
  title="Matis Di Piazza"
  description="Computer science engineering student interested in software engineering, cloud and machine learning."
>
  <header class="intro">
    <Image
      src={photo}
      alt="Portrait of Matis Di Piazza"
      width={128}
      height={128}
      densities={[1, 2]}
      loading="eager"
      class="avatar"
    />
    <div>
      <h1>Matis Di Piazza</h1>
      <p class="muted">
        Computer science engineering student, interested in software engineering, cloud
        infrastructure and machine learning. I like building systems that are tested,
        observable and easy to run.
      </p>
      <nav class="links">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </header>

  <section>
    <h2>Projects</h2>
    {
      projects.map((project) => (
        <article class="project">
          <a href={`/projects/${project.id}/`}>
            <Image src={project.data.cover} alt={project.data.coverAlt} width={720} loading="eager" />
          </a>
          <h3>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </h3>
          <p>{project.data.summary}</p>
          <Stack items={project.data.stack} />
        </article>
      ))
    }
  </section>

  <section>
    <h2>Skills</h2>
    <dl class="skills">
      {
        skills.map((skill) => (
          <>
            <dt>{skill.area}</dt>
            <dd>{skill.items}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .avatar {
    flex-shrink: 0;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
    border: none;
  }

  @media (max-width: 30rem) {
    .intro {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .project h3 {
    margin: 1rem 0 0.25rem;
  }

  .project p {
    margin: 0;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .skills {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .skills {
      grid-template-columns: 1fr;
    }

    .skills dd {
      margin-bottom: 0.6rem;
    }
  }
</style>
